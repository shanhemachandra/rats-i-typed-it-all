{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rats, I Typed It All",
  "version": "0.1.1",
  "identifier": "com.ratsityped.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Rats, I Typed It All",
        "width": 640,
        "height": 820,
        "minWidth": 520,
        "minHeight": 640,
        "resizable": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (c) 2026",
    "category": "Productivity",
    "shortDescription": "Type text where paste does not reach.",
    "longDescription": "Rats, I Typed It All sends your text as real keystrokes to any application, including remote desktop sessions and fields that block pasting.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
